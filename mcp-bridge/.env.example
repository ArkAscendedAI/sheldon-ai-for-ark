# =============================================================================
#  Sheldon Bridge - environment configuration
# =============================================================================
#  HOW TO USE:
#    1. Copy this file to ".env"        (cp .env.example .env)
#    2. Fill in the two REQUIRED values below.
#    3. Uncomment and change any optional value you care about. Anything left
#       commented uses the built-in default shown next to it.
#
#  Every setting the bridge understands is listed here. Settings are read in
#  this order of precedence:  environment variables  >  config.json  >  defaults
#  You do NOT need a config.json at all; the .env file alone is enough.
# =============================================================================


# =============================================================================
#  REQUIRED
# =============================================================================

# 1) Your LLM API key. This is the key for whichever provider you pick under
#    "LLM provider" below. Get it from the provider's dashboard.
#    (Alternatively, leave this blank and set the provider's own native key
#    variable instead - see "Native provider keys" near the bottom.)
SHELDON_LLM_API_KEY=your-llm-api-key-here

# 2) The shared password the ARK mod uses to authenticate to this bridge.
#    It MUST match the AuthSecret in your server's GameUserSettings.ini
#    [SheldonAI] section EXACTLY. Generate a strong one with either:
#        sheldon-bridge secret
#        openssl rand -base64 48
SHELDON_SHARED_SECRET=change-me-to-a-long-random-string


# =============================================================================
#  LLM provider, model and tuning   (optional - defaults shown)
# =============================================================================

# Which provider the key above belongs to:
#   openrouter | anthropic | openai | gemini   (any LiteLLM provider works too)
#SHELDON_LLM_PROVIDER=openrouter

# The model id, in the format your provider expects. The built-in defaults can
# lag behind new releases, so it is best to set this explicitly. Check your
# provider's model list for the exact id. Examples:
#   openrouter : openrouter/anthropic/claude-sonnet-4.6
#   anthropic  : anthropic/claude-sonnet-4-6
#   openai     : openai/gpt-4o
#   gemini     : gemini/gemini-2.0-flash
#SHELDON_LLM_MODEL=anthropic/claude-sonnet-4-6

# Maximum tokens Sheldon may generate in a single reply.
#SHELDON_MAX_TOKENS=4096

# Sampling temperature (0.0 = focused, 1.0 = creative).
#SHELDON_TEMPERATURE=0.7

# Seconds to wait for the LLM before giving up on a request.
#SHELDON_LLM_TIMEOUT=60

# How many times to retry a failed LLM call before falling back.
#SHELDON_LLM_RETRIES=2

# Most tool calls Sheldon may chain together to answer one question.
#SHELDON_MAX_TOOL_ITERATIONS=25

# Optional automatic failover. A comma-separated list of LiteLLM model strings
# to try, in order, if the primary model keeps failing. Leave empty to disable.
#SHELDON_LLM_FALLBACK_MODELS=openai/gpt-4o,gemini/gemini-2.0-flash


# =============================================================================
#  Network / transport   (optional - defaults shown)
# =============================================================================

# Address the bridge listens on. 0.0.0.0 means "all interfaces", which is what
# you want when the ARK server connects from another machine or container.
#SHELDON_WS_HOST=0.0.0.0

# Port the bridge listens on. Must match the port in the mod's WebSocketURL.
#SHELDON_WS_PORT=8443

# TLS / encryption:
#   - Leave BOTH of these unset (the default) and the bridge serves a plain
#     ws:// WebSocket. Your mod's WebSocketURL then uses ws://. This is the
#     normal, simplest setup and is fine for a private/LAN bridge.
#   - To serve wss:// instead, set BOTH to paths inside a mounted volume. If
#     the files do not exist yet, the bridge generates a self-signed pair at
#     those paths on first start. For clients that validate certificates,
#     mount your own real certificate at these paths instead.
#   If you enable TLS here, change the mod's WebSocketURL to wss://.
#SHELDON_SSL_CERT=/data/certs/bridge.crt
#SHELDON_SSL_KEY=/data/certs/bridge.key


# =============================================================================
#  Persona and server context   (optional - defaults shown)
# =============================================================================

# The name Sheldon answers to.
#SHELDON_PERSONA_NAME=Sheldon

# Path to a markdown file that fully defines Sheldon's personality / system
# prompt. Edit the file and restart the bridge to change his voice.
#SHELDON_PERSONA_FILE=/data/persona.md

# Path to a folder of markdown files describing YOUR server (rules, rates,
# installed mods, lore). Sheldon reads these so he can answer questions about
# your server, not just vanilla ARK.
#SHELDON_SERVER_CONTEXT_DIR=/data/server-context


# =============================================================================
#  Identity and scoping   (optional - defaults shown)
# =============================================================================

# Sheldon stores durable memory per "cluster" and live world state per "server".
# A single standalone server is one cluster with one server under it, so the
# defaults are fine. Change these only if you run multiple servers/clusters.
#SHELDON_DEFAULT_CLUSTER_ID=default
#SHELDON_DEFAULT_SERVER_ID=default

# For a host running several ARK servers through one bridge: map the source IP
# of each server to its (server_id, cluster_id), as JSON on one line.
#SHELDON_SERVER_IP_MAP={"192.0.2.50":{"server_id":"ragnarok","cluster_id":"mycluster"}}


# =============================================================================
#  Persistence and behavior   (optional - defaults shown)
# =============================================================================

# Where the databases live. Mount a Docker volume here so they survive a
# restart. Holds <cluster>/campaign.db (durable memory - BACK THIS UP) and
# <cluster>/<server>/telemetry.db (disposable live state).
#SHELDON_DATA_ROOT=/data

# Token budget for the context Sheldon assembles per message (persona + live
# telemetry + memory + recent chat). Larger = more context, higher cost.
#SHELDON_TOKEN_BUDGET=14000


# =============================================================================
#  Dino census   (optional - default OFF)
# =============================================================================

# A continuous background scan that keeps a fresh map-wide index of wild and
# tamed dinos, which powers the "find dinos" tool and dino map pins.
# Accepts: true | 1 | yes | on
# Leave OFF unless the mod's dino-scan feature is live in-game, or scans will
# simply get no reply.
#SHELDON_CENSUS_ENABLED=false


# =============================================================================
#  Logging   (optional - defaults shown)
# =============================================================================

# Log verbosity: DEBUG | INFO | WARNING | ERROR
#SHELDON_LOG_LEVEL=INFO

# Where the audit log of every tool action is written.
#SHELDON_AUDIT_FILE=/data/logs/audit.jsonl


# =============================================================================
#  Native provider keys   (optional - an alternative to SHELDON_LLM_API_KEY)
# =============================================================================
#  If you prefer, leave SHELDON_LLM_API_KEY blank and instead set the standard
#  environment variable your provider uses. LiteLLM picks it up automatically.
#  Set only the one for the provider you chose above.
#OPENROUTER_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GOOGLE_API_KEY=


# =============================================================================
#  Advanced   (optional - most people never touch these)
# =============================================================================

# Treat two player ids as the same survivor (JSON map of alias -> canonical id).
# Only needed if you changed the mod's identity scheme mid-campaign. Default empty.
#SHELDON_IDENTITY_ALIASES={"legacy-id":"canonical-id"}

# Register an extra OpenAI-compatible, chat-only relay endpoint as a fallback
# model. Both must be set, and the model id added to SHELDON_LLM_FALLBACK_MODELS,
# before it is used. Most people do not need this.
#SHELDON_CLAUDECODE_BRIDGE_URL=
#SHELDON_CLAUDECODE_BRIDGE_SECRET=
